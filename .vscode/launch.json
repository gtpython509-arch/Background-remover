{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run API (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Batch CLI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/batch.py",
      "args": ["./input", "-o", "./output"],
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
