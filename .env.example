# ---------------------------------------------------------------------------
# Copy to `.env` and edit. Every key is optional; the defaults are production
# oriented. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- runtime -----------------------------------------------------------------
RMBG_ENVIRONMENT=production          # development | staging | production
RMBG_HOST=127.0.0.1                  # keep on loopback; nginx is the public face
RMBG_PORT=8000
RMBG_LOG_LEVEL=INFO
RMBG_LOG_JSON=true
RMBG_SERVE_UI=true                   # set false once you have your own front-end

# /docs (Swagger UI) and /openapi.json. Unset = on outside production.
# Set true in production only if you need the schema reachable remotely, e.g.
# to import into Postman from a deployed host - it publishes every endpoint.
# RMBG_ENABLE_DOCS=true
# RMBG_ROOT_PATH=/api                # only if nginx mounts the app on a sub-path

# --- security (SET THIS BEFORE GOING LIVE) -----------------------------------
# Comma-separated. LEAVING THIS EMPTY DISABLES AUTHENTICATION ENTIRELY - which
# is what you want for local/Postman testing, and never what you want on a
# public host. The service logs a warning at startup while it is empty.
# Generate a key with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
RMBG_API_KEYS=
RMBG_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RMBG_TRUSTED_PROXY_COUNT=1           # number of reverse proxies in front of the app

# --- rate limiting -----------------------------------------------------------
RMBG_RATE_LIMIT_ENABLED=true
RMBG_RATE_LIMIT_REQUESTS=60
RMBG_RATE_LIMIT_WINDOW_SECONDS=60

# --- model -------------------------------------------------------------------
# RMBG-1.4 is CC BY-NC 4.0 (non-commercial). For commercial use buy a BRIA
# licence or swap in a permissively licensed checkpoint here.
RMBG_MODEL_ID=briaai/RMBG-1.4
# RMBG_MODEL_REVISION=               # pin a commit sha for reproducible builds
RMBG_MODEL_CACHE_DIR=/var/lib/rmbg/models
RMBG_LOCAL_FILES_ONLY=false          # true after running scripts/download_model.py
RMBG_DEVICE=auto                     # auto | cpu | cuda
RMBG_MODEL_INPUT_SIZE=1024
RMBG_TORCH_THREADS=2                 # match your vCPU count on a small VPS
RMBG_WARMUP_ON_STARTUP=true

# --- capacity ----------------------------------------------------------------
RMBG_INFERENCE_WORKERS=1             # leave at 1 unless you have spare RAM
RMBG_MAX_QUEUED_REQUESTS=16
RMBG_INFERENCE_TIMEOUT_SECONDS=120

# --- input limits ------------------------------------------------------------
RMBG_MAX_UPLOAD_BYTES=15728640       # 15 MB
RMBG_MAX_PIXELS=50000000             # 50 MP decompression-bomb guard
RMBG_MAX_INPUT_DIMENSION=4096

# --- output ------------------------------------------------------------------
RMBG_DEFAULT_OUTPUT_FORMAT=png       # png | webp | jpeg | mask
RMBG_PNG_COMPRESS_LEVEL=6
RMBG_WEBP_QUALITY=90
RMBG_JPEG_QUALITY=92
# RMBG_DEFAULT_BACKGROUND=#ffffff

# --- fetch by URL (SSRF surface - leave off unless you need it) --------------
RMBG_ALLOW_REMOTE_FETCH=false
# RMBG_REMOTE_FETCH_ALLOWED_HOSTS=cdn.yourdomain.com

# --- object storage (optional; pip install -r requirements-storage.txt) ------
RMBG_STORAGE_ENABLED=false
# Backblaze B2 example:
# RMBG_S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# RMBG_S3_REGION=us-west-004
# RMBG_S3_BUCKET=my-cutouts
# RMBG_S3_ACCESS_KEY_ID=
# RMBG_S3_SECRET_ACCESS_KEY=
# RMBG_S3_KEY_PREFIX=cutouts/
# RMBG_S3_PUBLIC_BASE_URL=https://f004.backblazeb2.com/file/my-cutouts
# RMBG_S3_PRESIGN_SECONDS=0          # >0 returns a signed URL for private buckets
